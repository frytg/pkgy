# FRYTG socials

_default:
	just --list

# provision pinned tools (node, aube) and install dependencies
install:
	mise install
	aube install

fonts:
	deno task fonts

dev:
	aubx vite

build:
	deno task fonts
	aubr build

preview:
	aubx vite preview

lint:
	aubx vue-tsc -b --pretty false
	aubr biome check .

deploy:
	deno deploy
