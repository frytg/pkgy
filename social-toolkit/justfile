# FRYTG socials

_default:
	just --list

# provision pinned tools (node, aube) and install dependencies
install:
	mise install
	aube install

fonts:
	deno task fonts

dev:
	aubx vite

build:
	deno task fonts
	aubr build

preview:
	aubx vite preview

# typecheck, lint, and check formatting
lint:
	aubx vue-tsc -b --pretty false
	aubx oxlint .
	aubx oxfmt --check .

# write formatting fixes (incl. tailwind class sort)
fmt:
	aubx oxfmt .
alias format := fmt

deploy:
	deno deploy
