// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored — never commit it.

// WiFi credentials (the CoreInk only supports 2.4 GHz)
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"

// Plain HTTP base URL of the backend that serves
// /ext-api/openrouter/activity. Example:
//   http://10.0.0.10:8080
// The firmware uses WiFiClient (not WiFiClientSecure).
#define API_BASE_URL "http://10.0.0.10:8080"

// Optional: query params for the activity endpoint.
// Default view: "all" merges personal + work; joystick cycles
// all → personal → work. "7" = 7 days, "30" = 30 days.
#define ACTIVITY_DAYS "7"
#define ACTIVITY_ORG "all"

// Time in minutes between auto-refreshes. Joystick still wakes sooner.
// e-ink doesn't need frequent updates; light sleep keeps power low.
#define REFRESH_MINUTES 15
