set export

config := "frame.yaml"

_default:
	just --list

# validate config (needs secrets.yaml)
config:
	esphome config {{ config }}

# compile firmware
build:
	esphome compile {{ config }}

# flash over USB — OG must be in flash mode first (see README)
run:
	esphome run {{ config }}
alias flash := run

# serial logs only
logs:
	esphome logs {{ config }}

# clean build dir
clean:
	rm -rf .esphome
